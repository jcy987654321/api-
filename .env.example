# Environment Configuration
DB_HOST=localhost
DB_NAME=api_management
DB_USER=root
DB_PASS=

# Site Configuration
SITE_URL=https://api-management.example.com
SITE_NAME=API Management System
SITE_DESCRIPTION=Discover and explore powerful APIs for your projects
SITE_AUTHOR=API Management Team
TWITTER_HANDLE=@api_management

# SEO Configuration
DEFAULT_TITLE=API Management System
DEFAULT_DESCRIPTION=Discover and explore powerful APIs for your projects
DEFAULT_KEYWORDS=API, integration, development, REST, GraphQL
CUSTOM_KEYWORDS=
META_IMAGE=/assets/images/og-default.jpg
TWITTER_CARD_TYPE=summary_large_image

# Cache Configuration
SITEMAP_CACHE_DURATION=3600
RSS_CACHE_DURATION=1800
RSS_ITEMS_PER_FEED=50

# Development
APP_ENV=development
DEBUG=true